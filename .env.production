# SERVER
SERVER_TYPE=https
SERVER_PORT=8080
SERVER_URL=https://api.evolution.com.br

# CORS
CORS_ORIGIN=https://meusistema.com.br
CORS_METHODS=GET,POST
CORS_CREDENTIALS=false

# LOGGING
LOG_LEVEL=ERROR
LOG_COLOR=false
LOG_BAILEYS=error

# EVENT SYSTEM
EVENT_EMITTER_MAX_LISTENERS=10

# INSTÂNCIAS
DEL_INSTANCE=false

# DATABASE
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://usuario:senha@host_production:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_production
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=false

# BROKERS DESABILITADOS
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false

# WEBHOOKS
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true

# WHATSAPP CONFIG
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1015901307

# QRCODE
QRCODE_LIMIT=3
QRCODE_COLOR='#000000'

# CACHE
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# S3 (habilitar somente se for necessário enviar/armazenar mídias)
S3_ENABLED=false

# API KEY
AUTHENTICATION_API_KEY=PRODUCTION_API_KEY_CHANGE_ME
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LANGUAGE=pt-BR
